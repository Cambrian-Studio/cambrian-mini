{
  "name": "cambrian-mini",
  "version": "0.1.0",
  "private": true,
  "description": "A council approves a written brief with passkeys, an AI agent builds it in a sandbox through NEAR AI with a fixed budget, and every build leaves a record whose hash can be logged on NEAR.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/server.mjs",
    "test": "node scripts/test.mjs",
    "judge": "node scripts/judge.mjs",
    "demo": "node line/run-cli.mjs --offline --ticket test/line/fixtures/tickets/facts-page-1.json",
    "build:static": "node app/static-build.mjs",
    "check:wasm": "node scripts/check-wasm.mjs",
    "invite": "node scripts/invite.mjs",
    "solo": "node scripts/solo.mjs",
    "setup:live": "sh line/kit/setup-tools.sh",
    "verify:receipt": "node scripts/verify-receipt.mjs"
  }
}
